{
    "applicationId": "js.orion.editor",
    "version": "1.0.0",
    "defaultMode": "window",
    "url": "/editor/index.html",
    "enableInspector": true,
    "windowOptions": {
        "title": "COcode Editor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "borderless": true
    },
    "cli": {
        "binaryName": "cocode",
        "resourcesPath": "/editor/",
        "clientLibrary": "/editor/js/neutralino.js"
    },
    "extensions": [
        {
            "id": "js.cocode.hardware",
            "command": "extensions/cocode-hardware/cocode-hardware-linux"
        }
    ]
}
